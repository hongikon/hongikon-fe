# 배포 백엔드(hongikon-be). 로컬 백엔드로 붙을 땐 http://<내 PC IP>:8080 등으로 바꾼다.
# EAS 빌드는 이 파일이 아니라 eas.json 의 env 를, Netlify 웹 빌드는 netlify.toml 값을 쓴다.
EXPO_PUBLIC_API_BASE_URL=http://54.180.195.51

# 네이버 지도 Client ID (공개값 — 지도 스크립트 URL에 그대로 실린다)
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# 시크릿은 EXPO_PUBLIC_ 접두사를 붙이지 않는다 — 붙이면 번들에 그대로 실린다
NAVER_MAP_CLIENT_SECRET=
