# 로컬 개발용 값. 이 파일을 .env 로 복사해 쓴다(.env 는 git·EAS 업로드에서 빠진다).
#
# 실행 환경별로 값이 들어가는 곳이 다르다:
#   로컬(expo start)  → 이 .env
#   EAS 빌드          → eas.json 의 build.base.env  (+ 프로필별 APP_VARIANT)
#   EAS Update(OTA)   → EAS 환경 변수 + pnpm run update:<프로필> (docs/release-build.md)
#   Netlify 웹        → netlify.toml

# 배포 백엔드. 로컬 백엔드에 붙으려면:
#   iOS 시뮬레이터·웹  http://localhost:8080  (pnpm dev:local 이 이 값으로 띄운다)
#   Android 에뮬레이터 http://10.0.2.2:8080
#   실기기            http://<내 PC의 LAN IP>:8080
EXPO_PUBLIC_API_BASE_URL=https://api.hongikon.com

# 웹 관리자(/admin) 카카오 로그인 시작 주소의 호스트. API_BASE_URL 이 상대 경로(/api)일 때만 쓰인다
# (절대 주소면 그 값을 그대로 쓴다). 로그인 이동은 프록시를 거치면 안 되어 실제 API 도메인이어야 한다.
# 개발 중 백엔드 없이 화면만 보려면 http://localhost:8081/admin?mock=1
EXPO_PUBLIC_API_ORIGIN=https://api.hongikon.com

# 네이버 지도 Client ID (공개값 — 지도 스크립트 URL에 그대로 실린다)
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# 시크릿은 EXPO_PUBLIC_ 접두사를 붙이지 않는다 — 붙이면 번들에 그대로 실린다
NAVER_MAP_CLIENT_SECRET=

# 웹(hongikon.com) Apple 로그인 Services ID(Apple Developer > Identifiers > Services IDs). 비우면 웹 Apple 버튼은 '준비 중'.
# Return URL 은 https://hongikon.com/auth/apple/callback. Netlify 빌드 환경(netlify.toml)에도 같은 값을 넣는다.
EXPO_PUBLIC_APPLE_WEB_CLIENT_ID=
