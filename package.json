{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "expo": "~57.0.31",
    "expo-apple-authentication": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.22",
    "expo-notifications": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "^57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "~19.2.2",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "expo start",
    "dev:local": "EXPO_PUBLIC_API_BASE_URL=http://localhost:8080 expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web && node scripts/fix-web-export.mjs",
    "update:preview": "node scripts/eas-update.mjs preview",
    "update:production": "node scripts/eas-update.mjs production",
    "update:production:1.0.0": "APP_VERSION_OVERRIDE=1.0.0 node scripts/eas-update.mjs production",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "netlify:env:sync": "node scripts/netlify-env-sync.mjs",
    "test": "node --import ./scripts/test/register.mjs --test \"scripts/test/*.test.ts\""
  },
  "private": true
}
